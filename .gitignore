# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Precision evaluation harness cache (clones + built analyzer binaries).
.cache/

# Generated callgraph exports.
callgraphutil/taint.csv
callgraphutil/taint-metadata.csv

# Generated analyzer reports.
*.sarif

# GoReleaser build output.
dist/

# Composite action SARIF output (see action.yml).
results/

# Agent worktrees (transient)
.claude/worktrees/

# Stray command binaries built at the repo root, e.g. by `go build ./cmd/x/`.
# Each is a main package under cmd/; the leading slash confines the match to
# the root so it never hides a package directory (sql/, network/, cmd/sqli).
# cmd/xss needs no entry: the xss/ source directory occupies that name at the
# root, so its binary cannot land there.
/cmdi
/logi
/ptrv
/sqli
/ssadump
/ssrf
/taint
/taint-eval
/vuln
